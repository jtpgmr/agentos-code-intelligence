{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "launch/docker/agentos.Dockerfile"
    },
    "deploy": {
        "runtime": "V2",
        "numReplicas": 1,
        "startCommand": "/bin/sh -c \"exec /app/scripts/entrypoint.sh uvicorn app.main:app --host 0.0.0.0 --port $PORT\"",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 600,
        "sleepApplication": false,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}